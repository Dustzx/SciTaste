# SciTaste does not require credentials for the mock demo.
# Configure these only for a real execution backend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Recommended domestic providers
DASHSCOPE_API_KEY=
# Obtain the region/workspace-specific URL from Alibaba Cloud Model Studio.
BAILIAN_BASE_URL=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Remote GPU access is declared in configs/resources/gpu/hosts/. Keep the
# password local and use `scitaste resource access-status` to verify binding.
SCITASTE_GPU_3090_2_SSH_PASSWORD=

# Optional comparison gateways/providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
